{
  "name": "directus-extension-expandable-blocks-api",
  "version": "0.3.0",
  "description": "API endpoint extension for expandable blocks",
  "author": "Christopher Schwarz <christopher@neugebauerschwarz.com>",
  "license": "MIT",
  "homepage": "https://github.com/smartlabsAT/directus-expandable-blocks-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartlabsAT/directus-expandable-blocks-api.git"
  },
  "bugs": {
    "url": "https://github.com/smartlabsAT/directus-expandable-blocks-api/issues"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-endpoint",
    "m2a",
    "blocks",
    "api",
    "usage-tracking"
  ],
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "type-check": "tsc --noEmit && echo '✅ TypeScript type-check passed!'",
    "type-check:strict": "tsc --noEmit --project config/tsconfig.strict.json",
    "type-check:quality": "tsc --noEmit --project config/tsconfig.quality.json",
    "test": "vitest --config config/vitest.config.ts",
    "test:ui": "vitest --ui --config config/vitest.config.ts",
    "test:coverage": "vitest --coverage --config config/vitest.config.ts",
    "lint": "eslint . -c config/eslint.config.js",
    "lint:fix": "eslint . -c config/eslint.config.js --fix",
    "qodana": "./config/scripts/qodana-local.sh",
    "clean:outputs": "./config/scripts/cleanup-outputs.sh",
    "precommit": "npm run type-check && npm run lint",
    "prepublishOnly": "npm run type-check && npm run build && npm run test -- --run",
    "version": "npm run build && git add dist/",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^17.1.1",
    "@directus/types": "^15.0.1",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "^10.1.0",
    "knex": "^3.2.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
